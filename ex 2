#include <stdio.h>
#include <stdlib.h>

struct snode
{
    int data;
    struct snode *next;
};

void insertion(struct snode *, int, int);
void deletion(struct snode *, int);
struct snode *find(struct snode *, int);
struct snode *findprevious(struct snode *, int);
void print(struct snode *);

int main(void)
{
    struct snode *head, *p;
    int ch, x, m;

    /* Creation of header node */
    head = (struct snode *)malloc(sizeof(struct snode));

    if (head == NULL)
    {
        printf("Memory allocation failed\n");
        return 1;
    }

    head->data = -1;
    head->next = NULL;

    while (1)
    {
        printf("\n1. Insertion  2. Deletion  3. Find");
        printf("  4. Find Previous  5. Print  6. Exit\n");
        printf("Enter the choice for operations: ");
        scanf("%d", &ch);

        switch (ch)
        {
            case 1:
                printf("Enter the element to be inserted: ");
                scanf("%d", &x);

                printf("Enter the element after which new element is to be inserted: ");
                scanf("%d", &m);

                printf("Before Insertion\n");
                print(head);

                insertion(head, x, m);

                printf("\nAfter Insertion\n");
                print(head);
                break;

            case 2:
                printf("Enter the element to be deleted: ");
                scanf("%d", &x);

                printf("Before Deletion\n");
                print(head);

                deletion(head, x);

                printf("\nAfter Deletion\n");
                print(head);
                break;

            case 3:
                printf("Enter the element to be searched: ");
                scanf("%d", &x);

                p = find(head, x);

                if (p != NULL)
                    printf("The element is present\n");
                else
                    printf("The element is not present\n");
                break;

            case 4:
                printf("Enter the element to be searched: ");
                scanf("%d", &x);

                p = findprevious(head, x);

                if (p != NULL)
                    printf("The previous node contains: %d\n", p->data);
                else
                    printf("The element is not present\n");
                break;

            case 5:
                printf("The elements in the linked list are\n");
                print(head);
                break;

            case 6:
                free(head);
                exit(0);

            default:
                printf("Invalid choice\n");
        }
    }

    return 0;
}

void insertion(struct snode *head, int x, int m)
{
    struct snode *newnode, *p;

    newnode = (struct snode *)malloc(sizeof(struct snode));

    if (newnode == NULL)
    {
        printf("Memory allocation failed\n");
        return;
    }

    newnode->data = x;

    /* Insert at beginning when m = -1 */
    if (m == -1)
    {
        newnode->next = head->next;
        head->next = newnode;
        return;
    }

    p = head->next;

    while (p != NULL)
    {
        if (m == p->data)
        {
            newnode->next = p->next;
            p->next = newnode;
            return;
        }

        p = p->next;
    }

    printf("Element %d not found. Insertion not possible.\n", m);
    free(newnode);
}

void deletion(struct snode *head, int x)
{
    struct snode *p, *pre;

    pre = head;
    p = head->next;

    while (p != NULL)
    {
        if (x == p->data)
        {
            pre->next = p->next;
            free(p);
            return;
        }

        pre = p;
        p = p->next;
    }

    printf("Element not found\n");
}

struct snode *find(struct snode *head, int x)
{
    struct snode *p;

    p = head->next;

    while (p != NULL)
    {
        if (x == p->data)
            return p;

        p = p->next;
    }

    return NULL;
}

struct snode *findprevious(struct snode *head, int x)
{
    struct snode *p, *pre;

    pre = head;
    p = head->next;

    while (p != NULL)
    {
        if (x == p->data)
            return pre;

        pre = p;
        p = p->next;
    }

    return NULL;
}

void print(struct snode *head)
{
    struct snode *p;

    p = head->next;

    while (p != NULL)
    {
        printf("%d-->", p->data);
        p = p->next;
    }

    printf("NULL\n");
}



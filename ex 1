#include <stdio.h>
#include <stdlib.h>

int a[5], n;

void insertion(int x, int pos);
int deletion(int pos);
int search(int x);
void display(void);

int main(void)
{
    int i, ch, x, pos, del;

    printf("Enter the number of elements in the list: ");
    scanf("%d", &n);

    if (n < 0 || n > 5)
    {
        printf("Invalid number of elements.\n");
        return 0;
    }

    for (i = 0; i < n; i++)
    {
        printf("Enter the element for array: ");
        scanf("%d", &a[i]);
    }

    while (1)
    {
        printf("\n1. Insertion\n");
        printf("2. Deletion\n");
        printf("3. Search\n");
        printf("4. Display\n");
        printf("5. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &ch);

        switch (ch)
        {
            case 1:
                printf("Enter the element to be inserted: ");
                scanf("%d", &x);

                printf("Enter the position for insertion (0 to %d): ", n);
                scanf("%d", &pos);

                insertion(x, pos);
                display();
                break;

            case 2:
                printf("Enter the position of the element to be deleted (0 to %d): ", n - 1);
                scanf("%d", &pos);

                del = deletion(pos);

                if (del != -1)
                    printf("The deleted value is %d\n", del);

                display();
                break;

            case 3:
                printf("Enter the element to be searched: ");
                scanf("%d", &x);

                pos = search(x);

                if (pos == -1)
                    printf("The element is not present in the list\n");
                else
                    printf("The element is present at the %d position of the list\n", pos);

                break;

            case 4:
                display();
                break;

            case 5:
                exit(0);

            default:
                printf("Invalid choice\n");
        }
    }

    return 0;
}

void insertion(int x, int pos)
{
    int i;

    if (n == 5)
    {
        printf("List is full, cannot insert.\n");
        return;
    }

    if (pos < 0 || pos > n)
    {
        printf("Invalid position.\n");
        return;
    }

    i = n - 1;

    while (i >= pos)
    {
        a[i + 1] = a[i];
        i--;
    }

    a[pos] = x;
    n++;
}

int deletion(int pos)
{
    int i, del;

    if (n == 0)
    {
        printf("List is empty, cannot delete.\n");
        return -1;
    }

    if (pos < 0 || pos >= n)
    {
        printf("Invalid position.\n");
        return -1;
    }

    del = a[pos];

    i = pos + 1;

    while (i < n)
    {
        a[i - 1] = a[i];
        i++;
    }

    n--;

    return del;
}

int search(int x)
{
    int i;

    for (i = 0; i < n; i++)
    {
        if (x == a[i])
            return i;
    }

    return -1;
}

void display(void)
{
    int i;

    printf("\nThe elements of the list are:\n");

    for (i = 0; i < n; i++)
    {
        printf("%d ", a[i]);
    }

    printf("\n");
}                                                                                                                                                      


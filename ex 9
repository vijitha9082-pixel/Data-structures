#include <stdio.h>
#include <stdlib.h>

int h[20];
int n = 0;

void insert(int x);
void delete1(void);
void print(void);

int main()
{
    int ch, x;

    while (1)
    {
        printf("\n1. Insertion\n2. Deletion\n3. Print\n4. Exit\n");
        printf("Enter the choice: ");
        scanf("%d", &ch);

        switch (ch)
        {
            case 1:
                printf("Enter the element to be inserted: ");
                scanf("%d", &x);

                printf("Before Insertion\n");
                print();

                insert(x);

                printf("\nAfter Insertion\n");
                print();
                break;

            case 2:
                printf("Before Deletion\n");
                print();

                delete1();

                printf("After Deletion\n");
                print();
                break;

            case 3:
                printf("The elements of the heap\n");
                print();
                printf("\n");
                break;

            case 4:
                exit(0);

            default:
                printf("Invalid choice\n");
        }
    }

    return 0;
}

void insert(int x)
{
    int i;

    if (n >= 19)
    {
        printf("Heap is full\n");
        return;
    }

    n++;

    for (i = n; i > 1; i = i / 2)
    {
        if (h[i / 2] <= x)
            break;

        h[i] = h[i / 2];
    }

    h[i] = x;
}

void delete1(void)
{
    int i, c, del, x;

    if (n == 0)
    {
        printf("\nHeap is empty\n");
        return;
    }

    del = h[1];
    x = h[n];
    n--;

    for (i = 1; i * 2 <= n; i = c)
    {
        c = 2 * i;

        if (c < n && h[c] > h[c + 1])
            c = c + 1;

        if (x <= h[c])
            break;

        h[i] = h[c];
    }

    if (n > 0)
        h[i] = x;

    printf("\nThe deleted element is %d\n", del);
}

void print(void)
{
    int i;

    if (n == 0)
    {
        printf("Heap is empty");
        return;
    }

    for (i = 1; i <= n; i++)
        printf("%d\t", h[i]);
} 


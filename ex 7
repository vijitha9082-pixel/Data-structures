struct bstnode *insert(struct bstnode *t,int x)
{
if(t==NULL)
{
t=(struct bstnode *)malloc(sizeof(struct bstnode));
t->data=x;
t->left=NULL;
t->right=NULL;
}
else if(x<t->data)
t->left=insert(t->left,x);
else if(x>t->data)
t->right=insert(t->right,x);
else
printf("Duplicate element is not allowed\n");

return t;
}

struct bstnode *delete1(struct bstnode *t,int x)
{
struct bstnode *tmp;

if(t==NULL)
{
printf("The element is not present in the tree\n");
}
else if(x<t->data)
{
t->left=delete1(t->left,x);
}
else if(x>t->data)
{
t->right=delete1(t->right,x);
}
else
{
if(t->left!=NULL && t->right!=NULL)
{
tmp=findmin(t->right);
t->data=tmp->data;
t->right=delete1(t->right,tmp->data);
}
else
{
tmp=t;

if(t->left==NULL)
t=t->right;
else
t=t->left;

free(tmp);
}
}

return t;
}

void find(struct bstnode *t,int x)
{
if(t==NULL)
{
printf("The element is not present in the tree\n");
return;
}

if(x<t->data)
find(t->left,x);
else if(x>t->data)
find(t->right,x);
else
printf("The element is present\n");
}

struct bstnode *findmin(struct bstnode *t)
{
while(t->left!=NULL)
{
t=t->left;
}

return t;
}

struct bstnode *findmax(struct bstnode *t)
{
while(t->right!=NULL)
{
t=t->right;
}

return t;
}

void printinorder(struct bstnode *t)
{
if(t==NULL)
return;
else
{
printinorder(t->left);
printf("\t%d",t->data);
printinorder(t->right);
}
}

void printpreorder(struct bstnode *t)
{
if(t==NULL)
return;
else
{
printf("\t%d",t->data);
printpreorder(t->left);
printpreorder(t->right);
}
}

void printpostorder(struct bstnode *t)
{
if(t==NULL)
return;
else
{
printpostorder(t->left);
printpostorder(t->right);
printf("\t%d",t->data);
}
}
